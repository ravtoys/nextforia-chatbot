# Runtime
NODE_ENV=production
PUBLIC_BASE_URL=https://your-production-host.example
PORT=3000

# Authentication and webhook verification — generate independent random values.
VERIFY_TOKEN=replace-with-at-least-24-random-characters
DASHBOARD_KEY=replace-with-at-least-32-random-characters
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-independent-random-characters
META_APP_SECRET=replace-with-your-meta-app-secret
META_APP_ID=
META_WHATSAPP_CONFIG_ID=
DASHBOARD_USERS=[]

# Messaging
DEFAULT_TENANT_ID=rav-toys
TENANT_BRAND_NAME=RAV Toys
TENANT_CUSTOMER_NUMBER=1
TENANT_STATUS=active
TENANT_SERVICE_COUNTRY_CODE=CO
TENANT_SERVICE_COUNTRY_NAME=Colombia
TENANT_FOREIGN_NUMBER_CHECK_ENABLED=1
WA_TOKEN=replace-with-meta-system-user-token
PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
TENANT_DISPLAY_PHONE=+57 301 587 2708
META_APP_REVIEW_STATUS=approved
META_APP_REVIEW_APPROVED_AT=2026-07-24
# Cambiar a 1 solo despues de verificar el numero real y una prueba end-to-end.
WA_LIVE_ENABLED=0
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_SEND_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=
NOTIFICATION_PHONES=

# AI and persistence
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-4.1-mini
SUPABASE_URL=
SUPABASE_KEY=
DATA_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64url
ALLOW_SELF_HOSTED_SUPABASE=0
# Enable only after applying docs/supabase-multi-tenant-phase-a.sql.
SUPABASE_TENANT_COLUMNS_ENABLED=0

# Multimodal Prototype Agent — keep disabled until testing one tenant.
MULTIMODAL_AGENT_ENABLED=0
MULTIMODAL_AGENT_TENANT_IDS=rav-toys
MULTIMODAL_VOICE_INPUT_ENABLED=0
MULTIMODAL_IMAGE_INPUT_ENABLED=0
MULTIMODAL_VOICE_REPLIES_ENABLED=0
MULTIMODAL_TRANSCRIPTION_PROVIDER=openai
MULTIMODAL_VISION_PROVIDER=openai
MULTIMODAL_VOICE_PROVIDER=elevenlabs
MULTIMODAL_MAX_AUDIO_BYTES=16777216
MULTIMODAL_MAX_IMAGE_BYTES=6291456

# Customer Access v2 — Staging only until an explicit production release.
# Apply docs/migrations/20260721_customer_access_v2_up.sql to an isolated
# Staging Supabase project before enabling this gate.
CUSTOMER_ACCESS_V2_ENABLED=0
CUSTOMER_PANEL_BASE_URL=https://customer-panel.staging.example
# Optional comma-separated fallback origins included in invitation emails.
CUSTOMER_PANEL_FALLBACK_BASE_URLS=
CUSTOMER_INVITE_TTL_HOURS=24
CUSTOMER_ACCESS_EMAIL_PROVIDER=resend
CUSTOMER_INVITE_FROM_EMAIL=Nextfor IA <access@staging.example>
CUSTOMER_INVITE_REPLY_TO=
RESEND_API_KEY=

# Channel Connection Flow v1 — Staging only. Shows WhatsApp first and Instagram as optional.
# Apply docs/migrations/20260726_channel_connections_v1_up.sql first.
CHANNEL_CONNECTIONS_V1_ENABLED=0

# Payments v1 — Wompi Sandbox, Staging only.
# Never commit real values. Keep disabled in Production until Santiago approves.
PAYMENTS_V1_ENABLED=
PAYMENTS_ENV=
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENT_SECRET=
# Estimate used only when Wompi does not provide a real fee.
# Configure the terms of the merchant account; values below are deliberately blank.
WOMPI_ESTIMATED_FEE_RATE=
WOMPI_ESTIMATED_FIXED_FEE=
WOMPI_ESTIMATED_FEE_TAX_RATE=

# ElevenLabs + appointment pilot
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_DERCO_AGENT_ID=
ELEVENLABS_AGENT_TENANT_MAP={}
# Enable only after applying docs/supabase-appointments-pilot.sql.
SUPABASE_APPOINTMENTS_ENABLED=0

# Commerce
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-04

# Never enable in production. Intended only for explicit local webhook fixtures.
ALLOW_UNSIGNED_WEBHOOKS=0
