# Runtime
NODE_ENV=production
PUBLIC_BASE_URL=https://your-production-host.example
PORT=3000

# Authentication and webhook verification — generate independent random values.
VERIFY_TOKEN=replace-with-at-least-24-random-characters
DASHBOARD_KEY=replace-with-at-least-32-random-characters
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-independent-random-characters
META_APP_SECRET=replace-with-your-meta-app-secret
META_APP_ID=
META_WHATSAPP_CONFIG_ID=
# Optional dedicated Embedded Signup configuration for WhatsApp Business App
# coexistence. When omitted, Nextfor uses META_WHATSAPP_CONFIG_ID for both flows.
META_WHATSAPP_COEXISTENCE_CONFIG_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Instagram Login connects professional accounts directly, without requiring
# a Facebook Page. Keep the secret server-side; never expose it in panel HTML.
INSTAGRAM_LOGIN_ENABLED=1
INSTAGRAM_LOGIN_APP_ID=
INSTAGRAM_LOGIN_APP_SECRET=
DASHBOARD_USERS=[]

# Messaging
DEFAULT_TENANT_ID=rav-toys
TENANT_BRAND_NAME=RAV Toys
TENANT_CUSTOMER_NUMBER=1
TENANT_STATUS=active
TENANT_SERVICE_COUNTRY_CODE=CO
TENANT_SERVICE_COUNTRY_NAME=Colombia
TENANT_FOREIGN_NUMBER_CHECK_ENABLED=1
WA_TOKEN=replace-with-meta-system-user-token
PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
TENANT_DISPLAY_PHONE=+57 301 587 2708
# One-time safe adoption of an internal Meta asset into the tenant that owns it.
# Leave blank for normal customer OAuth. Never point two tenants to one number.
CHANNEL_CONNECTION_BOOTSTRAP_WHATSAPP_TENANT_ID=
# JSON map for tenant-ID migrations that represent the same customer. This
# prevents a legacy ID and its current ID from conflicting over the same asset.
CHANNEL_CONNECTION_INTERNAL_TENANT_ALIASES={}
META_APP_REVIEW_STATUS=approved
META_APP_REVIEW_APPROVED_AT=2026-07-24
# Cambiar a 1 solo despues de verificar el numero real y una prueba end-to-end.
WA_LIVE_ENABLED=0
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_SEND_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=
NOTIFICATION_PHONES=

# AI and persistence
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-4.1-mini
SUPABASE_URL=
SUPABASE_KEY=
DATA_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64url
ALLOW_SELF_HOSTED_SUPABASE=0
# Enable only after applying docs/supabase-multi-tenant-phase-a.sql.
SUPABASE_TENANT_COLUMNS_ENABLED=1

# Multimodal Input Agent — use * for the platform feature or CSV for a limited rollout.
MULTIMODAL_AGENT_ENABLED=0
MULTIMODAL_AGENT_TENANT_IDS=*
MULTIMODAL_VOICE_INPUT_ENABLED=0
MULTIMODAL_IMAGE_INPUT_ENABLED=0
MULTIMODAL_VOICE_REPLIES_ENABLED=0
MULTIMODAL_TRANSCRIPTION_PROVIDER=openai
MULTIMODAL_VISION_PROVIDER=openai
MULTIMODAL_VOICE_PROVIDER=elevenlabs
MULTIMODAL_MAX_AUDIO_BYTES=16777216
MULTIMODAL_MAX_IMAGE_BYTES=6291456

# Customer Access v2 — Staging only until an explicit production release.
# Apply docs/migrations/20260721_customer_access_v2_up.sql to an isolated
# Staging Supabase project before enabling this gate.
CUSTOMER_ACCESS_V2_ENABLED=0
CUSTOMER_PANEL_BASE_URL=https://customer-panel.staging.example
# Optional comma-separated fallback origins included in invitation emails.
CUSTOMER_PANEL_FALLBACK_BASE_URLS=
CUSTOMER_INVITE_TTL_HOURS=24
CUSTOMER_ACCESS_EMAIL_PROVIDER=resend
# Customer-facing setup email is always sent as Nextfor IA <info@nextforia.com>.
CUSTOMER_INVITE_REPLY_TO=info@nextforia.com
RESEND_API_KEY=

# Automated setup email journey. Apply the setup_email_deliveries migration first.
SETUP_EMAIL_JOURNEY_ENABLED=0
SETUP_EMAIL_INCOMPLETE_DELAY_MINUTES=120
SETUP_EMAIL_PAYMENT_DELAY_MINUTES=120

# Customer Panel operational notification emails. Uses the same Resend account
# and fixed sender Nextfor IA <info@nextforia.com>. Apply the notification-email
# migration and validate in Staging before enabling.
CUSTOMER_NOTIFICATION_EMAIL_ENABLED=0

# Bot Operations & Improvement v1
# Apply docs/migrations/20260814_bot_ops_v1_up.sql before deployment.
# Enabled automatically in Production when Supabase + DATA_ENCRYPTION_KEY exist;
# set to 0 only as an emergency rollback.
BOT_OPS_ENABLED=1
BOT_OPS_TIME_ZONE=America/Bogota
# Minutes after midnight in BOT_OPS_TIME_ZONE: 360 = 06:00, 390 = 06:30.
BOT_OPS_DAILY_MINUTE=360
BOT_OPS_WEEKLY_MINUTE=390
# Staging only: authenticated synthetic incident fixtures for rollout validation.
BOT_OPS_CONTROLLED_TESTS_ENABLED=0
# Critical alerts are sent independently from Super Admin via Resend.
BOT_OPS_ALERT_EMAIL=ops@nextforia.com
BOT_OPS_ALERT_FROM_EMAIL=Nextfor Bot Ops <ops@nextforia.com>

# Channel Connection Flow v1 — Staging only. Shows WhatsApp first and Instagram as optional.
# Apply both the v1 schema and 20260808_whatsapp_onboarding_v2_up.sql first.
CHANNEL_CONNECTIONS_V1_ENABLED=0
# Customer Panel PWA. Leave at 0 for a code-only rollout; enable after the
# install/offline/push review on the real HTTPS domain.
PWA_V1_ENABLED=0
# Required for public WhatsApp onboarding. Keep 0 until the old fleet is fully
# drained and the v2 migration, historical-owner preflight and backfill pass.
CHANNEL_CONNECTIONS_DEDICATED_STORE_ENABLED=0
# Set to 0 during a free-instance rolling cutover. This closes connector
# mutations while preserving already-connected webhook and outbound runtimes.
CHANNEL_CONNECTIONS_MUTATIONS_ENABLED=1

# Payments v1 — Wompi Sandbox, Staging only.
# Never commit real values. Keep disabled in Production until Santiago approves.
PAYMENTS_V1_ENABLED=
PAYMENTS_ENV=
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENT_SECRET=
# Estimate used only when Wompi does not provide a real fee.
# Configure the terms of the merchant account; values below are deliberately blank.
WOMPI_ESTIMATED_FEE_RATE=
WOMPI_ESTIMATED_FIXED_FEE=
WOMPI_ESTIMATED_FEE_TAX_RATE=

# Customer plans are public by default: Uno, Aura, Tempo and Atlas.
# Set to 0 only as an emergency rollback to the legacy chatbot-only rollout.
CUSTOMER_ALL_PLANS_ENABLED=1

# ElevenLabs + legacy appointment pilot controls
APPOINTMENT_SETUP_ENABLED=0
# Optional comma-separated tenant allowlist for controlled pilots while the
# public Appointment setup remains disabled. Example: grupo-derco
APPOINTMENT_SETUP_TENANT_IDS=
ELEVENLABS_API_KEY=
# Luciana/template agent used read-only to create one isolated Appointment agent
# per new customer. The template itself is never patched by this flow.
ELEVENLABS_APPOINTMENT_TEMPLATE_AGENT_ID=
# HMAC key (32+ chars) used to create tenant-scoped ElevenLabs calendar tools.
ELEVENLABS_APPOINTMENT_TOOL_SECRET=
ELEVENLABS_APPOINTMENT_TOOL_BASE_URL=https://api.nextforia.com
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_DERCO_AGENT_ID=
ELEVENLABS_AGENT_TENANT_MAP={}
# Map imported ElevenLabs phone_number_id -> tenant_id for real calls.
ELEVENLABS_DERCO_PHONE_NUMBER_ID=
ELEVENLABS_PHONE_NUMBER_TENANT_MAP={}
# When enabled, Nextfor assigns an already imported, unassigned ElevenLabs
# number if the tenant has no explicit mapping. It never buys or imports numbers.
ELEVENLABS_PHONE_AUTO_ASSIGN_ENABLED=1
# Required to let Super Admin PATCH the real ElevenLabs appointment agent from the approved setup.
# Keep 0 until agent_id -> tenant_id is mapped and the webhook is verified.
ELEVENLABS_APPOINTMENT_AGENT_WRITE_ENABLED=0
# Google Calendar OAuth for the appointment bot setup.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Add this authorized redirect URI in Google Cloud:
# https://nextforia.com/admin/appointment-calendar/google/callback
# Temporary operations map until tenant OAuth token storage is enabled.
# Example:
# APPOINTMENT_CALENDAR_TENANT_MAP={"grupo-derco":{"provider":"google","status":"connected","calendar_email":"agenda@cliente.com","calendar_id":"primary"}}
APPOINTMENT_CALENDAR_TENANT_MAP={}
# Enable only after applying docs/supabase-appointments-pilot.sql.
SUPABASE_APPOINTMENTS_ENABLED=0

# Commerce
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2026-04
SHOPIFY_APP_INSTALL_URL=
NEXFORIA_PAIRING_SECRET=replace-with-at-least-32-independent-random-characters
NEXFORIA_COMMERCE_SERVICE_SECRET=replace-with-at-least-32-independent-random-characters

# Never enable in production. Intended only for explicit local webhook fixtures.
ALLOW_UNSIGNED_WEBHOOKS=0
